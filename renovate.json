{
  "$schema": "https://docs.renovatebot.com/renovate-schema.json",
  "extends": [
    "config:best-practices",
    ":gitSignOff",
    ":rebaseStalePrs",
    "docker:disableMajor",
    "helpers:pinGitHubActionDigests"
  ],
  "baseBranchPatterns": [
    "dev",
    "/^release-1\\.(9|\\d{2,}).*/",
    "/^release-([2-9]|\\d{2,})\\..*/"
  ],
  "vulnerabilityAlerts": {
    "enabled": true,
    "addLabels": [
      "kind/security"
    ]
  },
  "osvVulnerabilityAlerts": true,
  "labels": [
    "kind/dependency upgrade"
  ]
}
